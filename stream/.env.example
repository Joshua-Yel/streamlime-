# Streamline app
VITE_APP_NAME=Streamline
VITE_APP_URL=https://watch.innewgen.com

# TMDB API (required, set these in Vercel project settings, not here)
VITE_TMDB_API_KEY=your_tmdb_api_key
VITE_TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token


# Licensed embed player templates (optional)
VITE_LEGAL_PLAYER_URL_TEMPLATE_MOVIE=https://player.videasy.net/movie/{tmdbId}
VITE_LEGAL_PLAYER_URL_TEMPLATE_TV=https://player.videasy.net/tv/{tmdbId}/{season}/{episode}

# Optional direct stream templates for adaptive playback on devices/TV boxes
# HLS (.m3u8) and DASH (.mpd) are supported in EmbeddedWatchPage
# VITE_LEGAL_PLAYER_URL_TEMPLATE_MOVIE=https://stream.example/movie/{tmdbId}/master.m3u8
# VITE_LEGAL_PLAYER_URL_TEMPLATE_TV=https://stream.example/tv/{tmdbId}/{season}/{episode}/manifest.mpd





